APP_ENV=dev
HTTP_ADDR=:8080
HTTP_TIMEOUT=5s
API_KEY=local-dev-key
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=100
POSTGRES_URL=postgres://relaysync:relaysync@postgres:5432/relaysync?sslmode=disable
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=relaysync:locations
REDIS_GROUP=relaysync-consumers
REDIS_CONSUMER=consumer-1
STREAM_BLOCK=2s
STREAM_BATCH_SIZE=200
STREAM_BATCH_WINDOW=500ms
LOCATION_TTL=30s
METRICS_PATH=/metrics
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_TOPIC_PREFIX=courier-
NOTIFICATION_QUEUE=1000
NOTIFIER_WORKERS=4
